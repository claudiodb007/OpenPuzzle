+constexpr std::size_t entries_per_block = 4096;
+
+inline std::array<unsigned char, 4> checksum(const void* data, std::size_t size) {
+    const auto value = crc32(0, static_cast<const Bytef*>(data), static_cast<uInt>(size));
+    return {static_cast<unsigned char>(value),
+            static_cast<unsigned char>(value >> 8),
+            static_cast<unsigned char>(value >> 16),
+            static_cast<unsigned char>(value >> 24)};
+}
+
+// Blocks carry one mode byte, a checksum of the original entries, and either
+// raw entries or a bitmap followed by occupied entries in ascending slot order.
+// The caller supplies the table length from the checkpoint container.
+template <typename Entry>
+bool writeTable(FILE* stream, const Entry* table, std::size_t count) {
+    static_assert(sizeof(Entry) == 16 && std::is_trivially_copyable_v<Entry>);
+    std::array<Entry, entries_per_block> occupied;
+    while (count != 0) {
+        const auto slots = std::min(count, entries_per_block);
+        const auto bitmap_size = (slots + 7) / 8;
+        std::array<unsigned char, entries_per_block / 8> bitmap{};
+        std::size_t occupied_count = 0;
+        for (std::size_t i = 0; i < slots; ++i) {
+            if (table[i].part1 == 0 && table[i].part2 == 0) {
+                continue;
+            }
+            bitmap[i / 8] |= 1u << (i % 8);
+            occupied[occupied_count++] = table[i];
+        }
+        const auto raw_size = slots * sizeof(Entry);
+        const auto occupied_size = occupied_count * sizeof(Entry);
+        const bool compact = bitmap_size + occupied_size < raw_size;
+        const auto crc = checksum(table, raw_size);
+        if (std::fputc(compact ? 1 : 0, stream) == EOF ||
+            std::fwrite(crc.data(), 1, crc.size(), stream) != crc.size()) {
+            return false;
+        }
+        if (compact) {
+            if (std::fwrite(bitmap.data(), 1, bitmap_size, stream) != bitmap_size ||
+                std::fwrite(occupied.data(), 1, occupied_size, stream) != occupied_size) {
+                return false;
+            }
+        } else if (std::fwrite(table, 1, raw_size, stream) != raw_size) {
+            return false;
+        }
+        table += slots;
+        count -= slots;
+    }
+    return true;
+}
+
+template <typename Entry>
+bool readTable(FILE* stream, Entry* table, std::size_t count) {
+    static_assert(sizeof(Entry) == 16 && std::is_trivially_copyable_v<Entry>);
+    std::array<Entry, entries_per_block> block;
+    std::array<Entry, entries_per_block> occupied;
+    while (count != 0) {
+        const auto slots = std::min(count, entries_per_block);
+        const auto raw_size = slots * sizeof(Entry);
+        const int mode = std::fgetc(stream);
+        std::array<unsigned char, 4> expected_crc;
+        if ((mode != 0 && mode != 1) ||
+            std::fread(expected_crc.data(), 1, expected_crc.size(), stream) != expected_crc.size()) {
+            return false;
+        }
+        if (mode == 0) {
+            if (std::fread(block.data(), 1, raw_size, stream) != raw_size) {
+                return false;
+            }
+        } else {
+            const auto bitmap_size = (slots + 7) / 8;
+            std::array<unsigned char, entries_per_block / 8> bitmap;
+            if (std::fread(bitmap.data(), 1, bitmap_size, stream) != bitmap_size) {
+                return false;
+            }
+            if (slots % 8 != 0 && (bitmap[bitmap_size - 1] >> (slots % 8)) != 0) {
+                return false;
+            }
+            std::size_t occupied_count = 0;
+            for (std::size_t i = 0; i < slots; ++i) {
+                occupied_count += (bitmap[i / 8] >> (i % 8)) & 1u;
+            }
+            if (bitmap_size + occupied_count * sizeof(Entry) >= raw_size ||
+                std::fread(occupied.data(), sizeof(Entry), occupied_count, stream) != occupied_count) {
+                return false;
+            }
+            std::size_t next = 0;
+            for (std::size_t i = 0; i < slots; ++i) {
+                block[i] = ((bitmap[i / 8] >> (i % 8)) & 1u) ? occupied[next++] : Entry{};
+            }
+        }
+        if (checksum(block.data(), raw_size) != expected_crc) {
+            return false;
+        }
+        if (table) {
+            std::memcpy(table, block.data(), raw_size);
+            table += slots;
+        }
+        count -= slots;
+    }
+    return true;
+}
