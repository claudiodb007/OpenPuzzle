+    // The compact container keeps the native header and bucket layout, adds
+    // checksummed table blocks, then a checksum of the header and bucket states.
+    bool ReadBitmapCheckpoint(FILE* fp, const CheckpointHeader& header, bool preload) {
+        if (header.version != 4 || header.wild_table_size != wild_table_size ||
+            (header.tables_present != 1 && header.tables_present != 3) ||
+            header.circular_mode_w1 > 1 || header.circular_mode_w2 > 1) {
+            return false;
+        }
+        for (int t = 0; t < 2; ++t) {
+            if ((header.tables_present & (1u << t)) &&
+                !checkpoint_bitmap::readTable(fp, preload && t == 0 ? nullptr : wild_table[t],
+                                              wild_table_size)) {
+                return false;
+            }
+        }
+        u32 crc = crc32(0, reinterpret_cast<const Bytef*>(&header), sizeof(header));
+        for (u32 i = 0; i < SPATIAL_BUCKETS; ++i) {
+            u64 state[2];
+            if (fread(state, sizeof(u64), 2, fp) != 2) return false;
+            crc = crc32(crc, reinterpret_cast<const Bytef*>(state), sizeof(state));
+            if (!preload) {
+                spatial_buckets[i].write_index.store(state[0]);
+                spatial_buckets[i].fill_count.store(state[1]);
+            }
+        }
+        u32 expected;
+        return fread(&expected, sizeof(expected), 1, fp) == 1 &&
+               expected == crc && fgetc(fp) == EOF && !ferror(fp);
+    }
