+#ifndef _WIN32
+    static bool CompactLegacyCheckpoint(const char* source, const char* destination) {
+        const int input_fd = open(source, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+        if (input_fd < 0) return false;
+        const auto close_input = [](FILE* stream) { fclose(stream); };
+        std::unique_ptr<FILE, decltype(close_input)> input(fdopen(input_fd, "rb"), close_input);
+        if (!input) {
+            close(input_fd);
+            return false;
+        }
+        struct stat original{}, existing{};
+        CheckpointHeader header{};
+        if (lstat(destination, &existing) == 0 || errno != ENOENT ||
+            fstat(input_fd, &original) != 0 || !S_ISREG(original.st_mode) ||
+            fread(&header, sizeof(header), 1, input.get()) != 1) return false;
+
+        if (memcmp(header.magic, "RCKDT5B", 8) == 0) {
+            header.tables_present = 3;
+        } else if (memcmp(header.magic, "RCKDT5C", 8) != 0 || header.version != 3) {
+            return false;
+        }
+        if ((header.tables_present != 1 && header.tables_present != 3) ||
+            header.circular_mode_w1 > 1 || header.circular_mode_w2 > 1 ||
+            header.wild_table_size == 0 || header.wild_count_w1 > header.wild_table_size ||
+            header.wild_count_w2 > header.wild_table_size) return false;
+
+        const int table_count = header.tables_present == 3 ? 2 : 1;
+        const auto metadata_size = sizeof(header) + SPATIAL_BUCKETS * 2 * sizeof(u64);
+        const auto slot_bytes = sizeof(WildEntryCompact) * table_count;
+        if (original.st_size < 0 || static_cast<u64>(original.st_size) < metadata_size) return false;
+        const auto table_bytes = static_cast<u64>(original.st_size) - metadata_size;
+        if (table_bytes % slot_bytes != 0 || table_bytes / slot_bytes != header.wild_table_size)
+            return false;
+
+        std::string temporary = std::string(destination) + ".tmp.XXXXXX";
+        const int output_fd = mkstemp(temporary.data());
+        if (output_fd < 0) return false;
+        FILE* output = fdopen(output_fd, "wb");
+        if (!output) {
+            close(output_fd);
+            unlink(temporary.c_str());
+            return false;
+        }
+        const auto convert = [&]() {
+            memcpy(header.magic, "OPZKCP1", 8);
+            header.version = 4;
+            if (fwrite(&header, sizeof(header), 1, output) != 1) return false;
+            std::array<WildEntryCompact, checkpoint_bitmap::entries_per_block> block;
+            for (int t = 0; t < table_count; ++t) {
+                for (u64 remaining = header.wild_table_size; remaining != 0;) {
+                    const auto slots = std::min<u64>(remaining, block.size());
+                    if (fread(block.data(), sizeof(WildEntryCompact), slots, input.get()) != slots ||
+                        !checkpoint_bitmap::writeTable(output, block.data(), slots)) return false;
+                    remaining -= slots;
+                }
+            }
+            u32 crc = crc32(0, reinterpret_cast<const Bytef*>(&header), sizeof(header));
+            for (u32 i = 0; i < SPATIAL_BUCKETS; ++i) {
+                u64 state[2];
+                if (fread(state, sizeof(state), 1, input.get()) != 1 ||
+                    fwrite(state, sizeof(state), 1, output) != 1) return false;
+                crc = crc32(crc, reinterpret_cast<const Bytef*>(state), sizeof(state));
+            }
+            struct stat after{};
+            return fgetc(input.get()) == EOF && !ferror(input.get()) &&
+                   fstat(input_fd, &after) == 0 && after.st_size == original.st_size &&
+                   after.st_mtim.tv_sec == original.st_mtim.tv_sec &&
+                   after.st_mtim.tv_nsec == original.st_mtim.tv_nsec &&
+                   after.st_ctim.tv_sec == original.st_ctim.tv_sec &&
+                   after.st_ctim.tv_nsec == original.st_ctim.tv_nsec &&
+                   fwrite(&crc, sizeof(crc), 1, output) == 1 && FSYNC_FILE(output) == 0;
+        };
+        const bool converted = convert();
+        const bool closed = fclose(output) == 0;
+        // Publish the complete copy without replacing an existing destination.
+        const bool published = converted && closed && link(temporary.c_str(), destination) == 0;
+        unlink(temporary.c_str());
+        return published;
+    }
+#endif
