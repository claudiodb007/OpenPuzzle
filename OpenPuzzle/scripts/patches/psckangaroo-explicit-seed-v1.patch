+            if (strlen(seedText) != 16) {
+                printf("Error: -seed must contain exactly 16 hexadecimal characters\r\n");
+                return false;
+            }
+
+            u64 parsedSeed = 0;
+
+            for (int i = 0; i < 16; i++) {
+                const char character = seedText[i];
+                int digit = -1;
+
+                if (character >= '0' && character <= '9')
+                    digit = character - '0';
+                else if (character >= 'a' && character <= 'f')
+                    digit = character - 'a' + 10;
+                else if (character >= 'A' && character <= 'F')
+                    digit = character - 'A' + 10;
+
+                if (digit < 0) {
+                    printf("Error: -seed must contain exactly 16 hexadecimal characters\r\n");
+                    return false;
+                }
+
+                parsedSeed = (parsedSeed << 4) | (u64)digit;
+            }
+
+            if (parsedSeed == 0) {
+                printf("Error: -seed must not be zero\r\n");
+                return false;
+            }
+
+            gWalkSeed = parsedSeed;
